# PupTV — environment configuration
#
# The app runs fully in DEMO MODE with no env vars at all (that is also
# what a plain local `next build` exercises). Live AI generation turns
# on only when REPLICATE_API_TOKEN is present on the server.

# Replicate — enables live generation on /create:
#   stills: google/nano-banana-pro   clips: kwaivgi/kling-v2.5-turbo-pro
# Prompts and inputs mirror pipeline/puptv_pipeline_test.py.
REPLICATE_API_TOKEN=r8_your_token_here

# Kill switch: set to "off" to force demo mode even when a token is set.
PUPTV_LIVE=on

# Supabase (INACTIVE — do not use; lib/supabase.ts is inert scaffolding)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
