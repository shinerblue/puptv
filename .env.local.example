# PupTV runs fully in demo mode with NO required environment variables.
# The Supabase project backing this app is currently inactive, and no
# API routes call Supabase or Replicate at runtime. Everything below
# is optional scaffolding for a future production build.

# Supabase (not used at runtime — lib/supabase.ts is unused/inert until re-enabled)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Replicate (real pipeline lives in pipeline/puptv_pipeline_test.py,
# not in the Next.js request path)
REPLICATE_API_TOKEN=your_replicate_api_token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
