# PupTV — environment configuration
#
# The app runs fully in DEMO MODE with no env vars at all (that is also
# what a plain local `next build` exercises). Live AI generation turns
# on only when REPLICATE_API_TOKEN is present on the server.

# Replicate — enables live generation on /create:
#   stills: google/nano-banana-pro   clips: kwaivgi/kling-v2.5-turbo-pro
# Prompts and inputs mirror pipeline/puptv_pipeline_test.py.
REPLICATE_API_TOKEN=r8_your_token_here

# Kill switch: set to "off" to force demo mode even when a token is set.
PUPTV_LIVE=on

# Supabase (INACTIVE — do not use; lib/supabase.ts is inert scaffolding)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (Google sign-in) ---------------------------------------------
# All three of these must be set together, or the app stays in its
# unauthenticated "coming soon" state — see docs/auth-setup.md for the
# exact Google Cloud Console click-path to get GOOGLE_CLIENT_ID/SECRET.

# Session/JWT signing secret. Generate with:
#   openssl rand -base64 33
AUTH_SECRET=

# OAuth 2.0 Web client credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed for non-Vercel hosts; Vercel sets VERCEL=1 automatically,
# which auth.ts already treats as an implicit "true" here.
# AUTH_TRUST_HOST=true
